  },
  "TRM-04": {
   "kind": "屋内",
   "design": "中央の屋内本堂。door-south→TRM-03、door-west→TRM-05、door-east→TRM-02。扉前の段差なし・回転余地。"
  },
  "TRM-05": {
   "kind": "屋内",
   "design": "本堂の西の屋内庫裏（住居）。door-hall→TRM-04、door-outside→TRM-03、door-back→TRM-06（勝手口）。"
  },
  "TRM-06": {
   "kind": "屋外",
   "design": "寺の勝手口へ入る土塀の細道。TRM-15.bottom から入り、TRM-06.right→TRM-16.left へ戻るループの一部。住居の裏の道（map-specifications）。"
  },
  "TRM-07": {
   "kind": "屋外",
   "design": "消雪パイプと寺の長塀の広い道。TRM-15 西↔TRM-08 東、北の山門→TRM-03。山門は中央より北寄り。"
  },
  "TRM-08": {
   "kind": "屋外",
   "design": "井戸と用水が合流するS字。TRM-07西↔TRM-09東、上端は塀・壁で閉じる（歩行マスク=黒。外への接続なし）。水路と井戸の縁は黒マスク。"
  },
  "TRM-09": {
   "kind": "屋外",
   "design": "湯気の煙突が立つ銭湯前。TRM-08西↔TRM-10南（bottom）。時期差は営業灯だけ、地形不変。"
  },
  "TRM-10": {
   "kind": "屋外",
   "design": "犀川側の団地へ下る雪囲いスロープ。TRM-09北→TRM-11南、蛇行する車椅子主路。途中の急段差なし。"
  },
  "TRM-11": {
   "kind": "屋外",
   "design": "犀川側の県営住宅の中庭。TRM-10北↔TRM-13東（立位期だけの石段口）、棟入口→TRM-12（ドア遷移）。"
  },
  "TRM-12": {
   "kind": "屋内",
   "design": "車椅子の回転余地がある県営住宅の団地室。TRM-11の棟入口からドア遷移。玄関→居間→窓際で、段差なし。"
  },
  "TRM-13": {
   "kind": "屋外",
   "design": "石段の下の古い坂道。TRM-11西↔TRM-14北、車椅子不可。事故後は入口を閉鎖（立てる時期のみ）。"
  },
  "TRM-14": {
   "kind": "屋外",
   "design": "段丘上の分岐、学校側へ向く眺め。TRM-13南↔SCH-01東、車椅子主路はSCH-01側。石段と学校坂を混同しない。"
  },
  "TRM-15": {
   "kind": "屋外",
   "design": "火の見櫓を曲がる見通しの悪い角。TRM-16西↔TRM-07東、南→TRM-06。細道は画面内で終えず TRM-06.right→TRM-16.left へ戻る（#51）。"
  },
  "TRM-16": {
   "kind": "屋外",
   "design": "用水と寺門が交わる斜め道。左端←TRM-06.right、右→TRM-15（東）、北→TRM-17。画面内で北東へ曲がる。犀川へ向かう出口はtop。"
  },
  "TRM-17": {
   "kind": "屋外",
   "design": "寺町台地の入口の坂。擁壁と石積み、細い用水、坂の上に寺の屋根。北上しつつ蛇行して段丘へ。車椅子主坂。"
  }
 },
